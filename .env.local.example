# ==========================================
# AdsLab — Environment Variables Example
# ==========================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it's in .gitignore).
# ==========================================

# ---- App ----
# Base URL of the app. In dev = http://localhost:3000. In prod = your Vercel URL.
APP_URL=http://localhost:3000

# ---- Database (Neon PostgreSQL) ----
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ---- Auth / Session ----
# A random string >= 32 characters used to encrypt session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-random-string-at-least-32-chars-long

# ---- AI Gateway (OpenRouter) ----
# Get API key from: https://openrouter.ai/keys
# One key routes to many providers (Anthropic, Google, OpenAI, etc.)
OPENROUTER_API_KEY=sk-or-v1-...
# Model slugs — change without redeploying code
AI_MODEL_ANALYSIS=anthropic/claude-sonnet-4.6
AI_MODEL_CHAT=google/gemini-2.0-flash-001
AI_MODEL_LITE=google/gemini-2.0-flash-lite-001

# ---- Meta Marketing API ----
# Create a Business app at https://developers.facebook.com/apps with
# Marketing API + Page management use cases. App ID is public; Secret is not.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# ---- Email (Resend) ----
# Get API key from: https://resend.com → API Keys
RESEND_API_KEY=re_replace-with-real-key
# Dev/test: onboarding@resend.dev (no own domain required)
# Production: noreply@yourdomain.com (after verifying domain in Resend dashboard)
MAIL_FROM="AdsLab <onboarding@resend.dev>"

# ---- File Storage (Vercel Blob) ----
# Get this from: https://vercel.com/dashboard → your project → Storage → Blob
# (Only required when Phase 1 features that store files are built; safe to leave empty for foundation work.)
BLOB_READ_WRITE_TOKEN=

# ---- Pipeboard (Meta Ads MCP) ----
# Filled in during `add-meta-integration` change proposal — not needed for foundation.
# PIPEBOARD_URL=
# PIPEBOARD_API_KEY=

# ---- Omise (Payments) ----
# Filled in during `add-billing` change proposal — not needed for foundation.
# OMISE_PUBLIC_KEY=
# OMISE_SECRET_KEY=
