// AdsLab Prisma Schema
// See https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  OWNER
  MEDIA_BUYER
  VIEWER
}

enum MetaConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum DailyReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum GoalObjective {
  AWARENESS
  ENGAGEMENT
  TRAFFIC
  LEADS
  SALES
  APP_PROMOTION
  STORE_VISITS
}

enum GoalKpi {
  ROAS
  CPM
  CTR
  CPC
  CPL
  CPA
  REACH
  FREQUENCY
  CONVERSIONS
  ENGAGEMENT_RATE
}

enum GoalSource {
  AUTO_META
  AUTO_NAME
  USER_MANUAL
  TENANT_DEFAULT
}

enum CampaignActionType {
  PAUSE
  RESUME
  SET_BUDGET
  SET_END_DATE
  DUPLICATE
  CREATE
}

enum CampaignActionResult {
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BillingEventKind {
  TRIAL_STARTED
  TRIAL_REMINDER_SENT
  TRIAL_CONVERTED
  CHARGE_SUCCESS
  CHARGE_FAILED
  UPGRADED
  DOWNGRADED
  ADDON_ADDED
  ADDON_REMOVED
  CANCELLED
  RESUMED
  REFUNDED
  SUSPENDED
}

// ============================================================
// Core models — Multi-tenant foundation
// ============================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  /// Per-user UI locale. One of "th" | "en" | "lo". Default "th".
  /// Source-of-truth for the adslab-locale cookie set at login time.
  preferredLocale String    @default("th")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships             TenantMember[]
  emailVerificationTokens EmailVerificationToken[]
  connectedMetaAccounts   MetaConnection[]         @relation("MetaConnectionConnector")
  connectedPageAccounts   MetaPageConnection[]     @relation("MetaPageConnectionConnector")
  viewerLinksCreated      ViewerLink[]             @relation("ViewerLinkCreator")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// SHA-256 hash of the tenant's MCP API key. Plaintext is shown to the
  /// user ONCE at generation time (via scripts/mcp-issue-key.ts) and never
  /// stored server-side. The MCP HTTP endpoint (/api/mcp) resolves the
  /// bearer token by hashing it and looking up this column. NULL until the
  /// tenant issues a key; rotation = overwrite this column.
  mcpApiKey String? @unique

  members            TenantMember[]
  metaConnection     MetaConnection?
  insightCaches      MetaInsightCache[]
  dailyReports       DailyReport[]
  campaignGoals      CampaignGoal[]
  namingConventions  NamingConvention[]
  reportScopes       ReportScope[]
  eventRules         EventRule[]
  eventLogs          EventLog[]
  capiAccessToken    CapiAccessToken?
  scope              TenantScope?
  namingTemplates    NamingTemplate[]
  aiPersona          AIPersona?
  knowledgeDocuments KnowledgeDocument[]
  subscription       TenantSubscription?
  invoices           Invoice[]
  usageMetrics       UsageMetric[]
  billingEvents      BillingEvent[]
  creatives          TenantCreative[]
  boostJobs          BoostJob[]
  autoRules          AutoRule[]
  aiRecommendations  AIRecommendation[]
  metaPageConnection MetaPageConnection?
  pagePosts          PagePost[]
  viewerLinks        ViewerLink[]
  hookConcepts       HookConcept[]
  hookAnalyses       HookAnalysis[]
  hookProfile        HookProfile?
  hookWinners        HookWinner[]
}

/// AI Quick Boost — natural-language → bulk campaign creation. One row
/// per "boost job" the user submits. Tracks the raw prompt, parsed
/// brief, and execution results for audit + retrospective analysis
/// ("did we actually hit the KPI we set?").
model BoostJob {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  /// Raw text the user pasted (e.g. client message).
  promptText      String
  /// Parser output: { urls[], budget, schedule, kpi, purpose, ... }
  parsedBrief     Json
  /// Per-brief execute result: { briefIndex, status, campaignId?, error? }[]
  executionResults Json?
  /// "planned" | "executing" | "executed" | "failed" | "cancelled"
  status          String    @default("planned")
  /// User-facing KPI string (e.g. "10,000 views" or "CPV ≤ 0.05")
  kpiText         String?
  /// User-facing purpose string (why this boost is being run)
  purposeText     String?
  createdAt       DateTime  @default(now())
  executedAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// User-defined automation rule: monitors live metrics on the user's Meta
/// campaigns/adsets and dispatches an action when the condition matches.
/// One rule = one (condition, action) pair. Multi-condition compound
/// rules are deferred to Phase 2.
model AutoRule {
  id              String    @id @default(cuid())
  tenantId        String
  /// Who created the rule (for audit + role checks at modify time).
  createdByUserId String
  /// Human-readable name shown in UI + emails.
  name            String
  /// Whether this rule is being evaluated on the hourly tick. Disabled
  /// rules stay in the DB but are skipped (their count doesn't apply to
  /// tier cap either).
  enabled         Boolean   @default(true)
  /// Minimum minutes between evaluations of this rule. Allows users to
  /// throttle expensive rules. Valid values: 60, 360, 720, 1440 (the UI
  /// presents these as 1h, 6h, 12h, 24h). Defaults to 60.
  minIntervalMinutes Int    @default(60)
  /// Structured condition payload: { metric, op, value, windowHours,
  /// scope }. See src/lib/rules/types.ts → RuleCondition.
  condition       Json
  /// Action enum: "pause_adset" | "pause_campaign" | "notify_email" |
  /// "notify_in_app". See src/lib/rules/types.ts → RuleAction.
  action          String
  /// Optional list of target Meta entity ids this rule applies to
  /// (e.g. specific adset_ids or campaign_ids). Empty = applies to all
  /// of the rule's scope (campaign/adset).
  targetIds       String[]  @default([])
  /// Bookkeeping for the runner to skip rules that fired too recently.
  lastFiredAt     DateTime?
  /// Bookkeeping for `minIntervalMinutes` throttling.
  lastEvaluatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutoRuleRun[]

  @@index([tenantId, enabled])
  @@index([enabled, lastEvaluatedAt])
}

/// Audit row: one per (rule, tick) evaluation. Stored so users can see
/// "what would have fired" even before they enable a rule, plus track
/// which rules are flapping vs steady.
model AutoRuleRun {
  id              String    @id @default(cuid())
  ruleId          String
  /// When this evaluation happened.
  tickAt          DateTime  @default(now())
  /// Snapshot of the metric Meta returned for the rule's window.
  evaluatedMetric String
  evaluatedValue  Float?
  threshold       Float
  /// Did the condition match this tick?
  matched         Boolean
  /// One of: "matched" | "not_matched" | "skipped_no_data" |
  /// "matched_in_cooldown" | "skipped_orphan" | "error". See
  /// src/lib/rules/types.ts → RuleRunStatus.
  status          String
  /// If the action fired, what was the result? "fired" | "no_change_needed"
  /// | "error" | null (when not matched).
  actionResult    String?
  /// Free-form error string when status === "error" or actionResult === "error".
  errorMessage    String?
  /// Which target entity was evaluated (adset_id or campaign_id). Lets
  /// the UI show "this rule evaluated against adset X" instead of the
  /// abstract rule.
  targetId        String

  rule AutoRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, tickAt])
}

/// Closed-loop optimization: every concrete AI recommendation across
/// the three emission channels (daily-report, chat-tool, rules-suggest)
/// is logged here. After 7 days a cron computes its outcome and writes
/// an AIRecommendationOutcome row. Future AI prompts inject recent
/// outcomes so the AI "remembers what worked" per-tenant.
model AIRecommendation {
  id              String   @id @default(cuid())
  tenantId        String
  /// "daily_report" | "chat_tool" | "rules_suggest"
  source          String
  /// "pause" | "resume" | "scale_budget" | "refresh_creative" |
  /// "change_budget" | "change_targeting" | "diagnose" | "other"
  actionType      String
  /// "campaign" | "adset" | "ad"
  targetKind      String
  /// Meta numeric id of the entity (campaign/adset/ad).
  targetMetaId    String
  /// Free-form rationale the AI provided.
  reasoning       String?
  /// Full action payload (e.g. for SET_BUDGET: { dailyBudget: 800 }).
  payload         Json?
  /// Null when sourced from cron (daily-report); populated for chat
  /// tool calls so we can show "your AI told you to do X" attribution.
  createdByUserId String?
  /// When sourced from chat, the conversation id for traceability.
  conversationId  String?
  createdAt       DateTime @default(now())

  tenant  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outcome AIRecommendationOutcome?

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

/// One-to-one outcome record for an AIRecommendation, computed after a
/// 7-day holding window. Captures whether the user followed the advice
/// and how the target's KPI moved.
model AIRecommendationOutcome {
  id               String   @id @default(cuid())
  recommendationId String   @unique
  /// "followed" | "ignored" | "opposite" | "target_deleted" | "no_data"
  actionTaken      String
  /// Structured KPI delta. Shape:
  /// `{ metric: "cpv"|"roas"|"spend"|"ctr"|"cpm", before: number,
  ///    after: number, percentChange: number }`. Null when target was
  /// deleted or no insight data was available for the windows.
  kpiDelta         Json?
  errorMessage     String?
  computedAt       DateTime @default(now())

  recommendation AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

/// Tenant-scoped creative asset (image or video) uploaded to blob storage
/// and reusable across campaigns. Soft-deleted via `deletedAt`.
model TenantCreative {
  id            String    @id @default(cuid())
  tenantId      String
  /// "image" | "video"
  kind          String
  /// Display name (defaults to original filename)
  name          String
  /// Public blob URL
  url           String
  /// Storage path returned by blob provider (used for delete)
  pathname      String
  /// MIME type (e.g. image/png, video/mp4)
  contentType   String
  sizeBytes     Int
  width         Int?
  height        Int?
  /// "upload" | "ai-gen"
  source        String    @default("upload")
  /// Optional Meta image hash if this asset has been pre-uploaded to Meta
  /// for ad creation. Saves a round trip in Campaign Builder.
  metaImageHash String?
  createdById   String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt, createdAt])
}

model TenantMember {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      Role
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// Meta integration — direct Marketing API (not Pipeboard)
// ============================================================

model MetaConnection {
  id                   String               @id @default(cuid())
  tenantId             String               @unique
  // AES-256-GCM encrypted access token (long-lived, ~60d expiry)
  accessTokenEncrypted String
  tokenExpiresAt       DateTime?
  // Facebook user who authorized the app
  metaUserId           String
  metaUserName         String
  // AdsLab user (must be tenant OWNER) who initiated the connection
  connectedByUserId    String
  status               MetaConnectionStatus @default(ACTIVE)
  connectedAt          DateTime             @default(now())
  lastSyncedAt         DateTime?

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedBy User            @relation("MetaConnectionConnector", fields: [connectedByUserId], references: [id])
  adAccounts  MetaAdAccount[]
  campaigns   MetaCampaign[]
  pages       MetaPage[]

  @@index([metaUserId])
  @@index([status])
}

model MetaAdAccount {
  id               String   @id @default(cuid())
  metaConnectionId String
  // Meta's account id, e.g. "act_1234567890"
  metaAccountId    String
  name             String
  currency         String
  timezoneName     String
  // Meta's account_status: 1=ACTIVE, 2=DISABLED, 3=UNSETTLED, etc.
  accountStatus    Int
  businessId       String?
  businessName     String?
  lastFetchedAt    DateTime @default(now())

  connection MetaConnection @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)

  @@unique([metaConnectionId, metaAccountId])
  @@index([metaConnectionId])
}

// AI Daily Report — one row per (tenant, day, scope). The cron at 09:00
// Bangkok always generates the FULL-tenant report (scopeId=null).
// Scoped reports are user-triggered only to keep AI token spend bounded.
model DailyReport {
  id               String            @id @default(cuid())
  tenantId         String
  // Optional FK to ReportScope. null = full tenant (default).
  scopeId          String?
  // Bangkok-local report date (yyyy-mm-dd). Stored as DateTime; we treat
  // as a calendar date by always inserting midnight UTC of the BKK date.
  reportDate       DateTime
  status           DailyReportStatus @default(GENERATING)
  // Markdown content returned by Claude. Null until status=COMPLETED.
  contentMd        String?           @db.Text
  // Snapshot of the insights data used to generate the report.
  payloadSnapshot  Json?
  // Structured action recommendations emitted by AI alongside the
  // markdown report. Each entry: { id, internalCampaignId, metaCampaignId,
  // action, params?, reason, status: pending|applied|dismissed,
  // appliedLogId?, errorMessage? }. Null until parsed.
  suggestedActions Json?
  promptTokens     Int               @default(0)
  completionTokens Int               @default(0)
  estimatedCostUsd Float             @default(0)
  deliveredAt      DateTime?
  deliveryError    String?           @db.Text
  generationError  String?           @db.Text
  // Null when generated by the cron; userId when manually requested.
  generatedBy      String?
  generatedAt      DateTime          @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope  ReportScope? @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  // Unique per (tenant, date, scope). Postgres treats NULL as distinct
  // in unique constraints, so the full-tenant cron can keep producing
  // one row per day without colliding with scoped reports.
  @@unique([tenantId, reportDate, scopeId])
  @@index([tenantId, generatedAt])
  @@index([scopeId])
}

// Named subset of a tenant's accounts and/or campaigns. Used to focus
// the AI report on one client / launch / etc. Empty arrays mean
// "everything" — so an empty scope is just a default that exists only
// as a convenience for the UI.
model ReportScope {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  // Meta ad account ids ("act_xxx"). Empty = all accounts of the tenant.
  accountIds  Json     @default("[]")
  // Meta campaign ids (digit strings). Empty = all campaigns in selected accounts.
  campaignIds Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reports DailyReport[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Server-side cache of Meta Insights API responses, keyed by tenant + scope
// (summary or single ad account) + date range. TTL'd via expiresAt.
model MetaInsightCache {
  id        String   @id @default(cuid())
  tenantId  String
  // "summary" = aggregated across all accounts; "act_xxxx" = single account
  scope     String
  // Either a preset name ("today" | "yesterday" | "last_7d" | "last_30d")
  // or a custom range encoded as "custom:YYYY-MM-DD..YYYY-MM-DD"
  rangeKey  String
  // Full response payload. Shape matches AggregatedInsights / PerAccountInsights
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, rangeKey])
  @@index([tenantId])
  @@index([expiresAt])
}

// ============================================================
// Campaign goals — gives the AI report a "what is this campaign
// trying to do?" answer instead of judging every account with
// the same generic ROAS/CTR rubric.
// ============================================================

// Snapshot of a Meta campaign. Synced alongside insights so we can
// link a CampaignGoal even when the campaign is paused / has no
// spend in the current report window.
model MetaCampaign {
  id               String    @id @default(cuid())
  metaConnectionId String
  // Meta's campaign id (string of digits)
  metaCampaignId   String
  // Meta ad account id, e.g. "act_123" — denormalized for fast filtering
  metaAccountId    String
  name             String
  // Meta's objective string, e.g. "OUTCOME_SALES", "OUTCOME_AWARENESS".
  // Null when Meta hasn't returned one (rare; usually legacy campaigns).
  metaObjective    String?
  // Meta's effective_status, e.g. "ACTIVE", "PAUSED", "DELETED".
  effectiveStatus  String
  // Meta's configured_status (what the user set).
  configuredStatus String?
  // Budget in minor units (e.g. ฿500 = 50000). Only populated for CBO
  // campaigns — null means budget is at ad-set level (ABO) and we
  // can't edit at the campaign level.
  dailyBudget      Int?
  lifetimeBudget   Int?
  // ISO datetime; null means no scheduled end.
  endTime          DateTime?
  lastFetchedAt    DateTime  @default(now())

  connection MetaConnection @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)
  goal       CampaignGoal?
  adSets     MetaAdSet[]

  @@unique([metaConnectionId, metaCampaignId])
  @@index([metaConnectionId])
  @@index([metaAccountId])
}

// Cached representation of an Ad Set under a campaign. Populated when
// AdsLab creates a campaign tree from scratch (Stage 3) or when we sync
// detailed campaign internals on demand.
model MetaAdSet {
  id                     String    @id @default(cuid())
  metaCampaignInternalId String
  // Meta ad set id (digit string)
  metaAdSetId            String
  name                   String
  // Budget at ad set level (ABO mode). null = CBO at campaign level.
  dailyBudget            Int?
  lifetimeBudget         Int?
  // Full targeting blob (location/age/gender/interests/audiences) as
  // returned by Meta. We don't normalize — too many shapes.
  targeting              Json?
  // Meta's optimization_goal enum, e.g. "REACH", "LINK_CLICKS".
  optimizationGoal       String?
  // Meta's billing_event enum, e.g. "IMPRESSIONS".
  billingEvent           String?
  startTime              DateTime?
  endTime                DateTime?
  effectiveStatus        String
  configuredStatus       String?
  lastFetchedAt          DateTime  @default(now())

  campaign MetaCampaign @relation(fields: [metaCampaignInternalId], references: [id], onDelete: Cascade)
  ads      MetaAd[]

  @@unique([metaAdSetId])
  @@index([metaCampaignInternalId])
}

// Cached representation of an Ad under an Ad Set. Same caveat as MetaAdSet.
model MetaAd {
  id                  String   @id @default(cuid())
  metaAdSetInternalId String
  // Meta ad id (digit string)
  metaAdId            String
  name                String
  // Meta creative id used by this ad. Multiple ads can share a creative.
  creativeId          String?
  effectiveStatus     String
  configuredStatus    String?
  lastFetchedAt       DateTime @default(now())
  /// Cached vision LLM evaluation of the ad's creative. Shape matches
  /// the analyzeAdCreative tool's return type — `hook`, `weaknesses`,
  /// `strengths`, etc. Populated by AI tool calls; never edited by user.
  creativeAnalysis    Json?
  /// When the creativeAnalysis was last refreshed. 7-day TTL: the AI
  /// tool re-runs vision past that.
  creativeAnalyzedAt  DateTime?

  adSet MetaAdSet @relation(fields: [metaAdSetInternalId], references: [id], onDelete: Cascade)

  @@unique([metaAdId])
  @@index([metaAdSetInternalId])
}

// Audit log for audience operations created via AdsLab. Append-only.
// Lets us answer "who uploaded this customer list?" + show creation
// history on the audiences page even after Meta-side rotation.
model AudienceCreationLog {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  metaAccountId  String
  // Meta audience id (digit string). Null when action is DELETE and we
  // only knew the name (rare).
  audienceId     String?
  name           String
  // CUSTOM / WEBSITE / LOOKALIKE / ENGAGEMENT etc.
  subtype        String
  // CUSTOMER_LIST / PIXEL_RULE / LOOKALIKE_FROM_AUDIENCE / LOOKALIKE_FROM_PAGE / DELETE
  sourceType     String
  // Approximate size at creation. Null for DELETE or LOOKALIKE (Meta
  // computes asynchronously).
  sizeAtCreation Int?
  // Free-form details JSON — e.g. hashed-row count, pixel rule, lookalike spec
  details        Json?
  errorMessage   String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([audienceId])
}

// Facebook Page the tenant manages. Required for ads because every ad
// publishes "as" a Page. We store the page-scoped access token (encrypted)
// because some operations (e.g. listing promotable posts) need it
// instead of the user token.
model MetaPage {
  id                       String   @id @default(cuid())
  metaConnectionId         String
  metaPageId               String
  name                     String
  category                 String?
  // Profile picture URL from Meta. May expire — refresh via syncPages.
  pictureUrl               String?
  // Page access token encrypted with the same key as MetaConnection.
  pageAccessTokenEncrypted String
  lastFetchedAt            DateTime @default(now())

  connection MetaConnection @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)

  @@unique([metaConnectionId, metaPageId])
  @@index([metaConnectionId])
}

// Separate Meta-app OAuth for organic page management. Distinct from
// MetaConnection (which is the ads-only app) because Meta refuses to add
// the "Manage Page" use case to a Marketing-API app. See
// memory/reference_meta_app_type_constraint.md for the discovery story.
// One tenant may have zero or one of each connection type independently.
model MetaPageConnection {
  id                   String               @id @default(cuid())
  tenantId             String               @unique
  // AES-256-GCM encrypted user access token from the page-management app
  accessTokenEncrypted String
  tokenExpiresAt       DateTime?
  metaUserId           String
  metaUserName         String
  connectedByUserId    String
  status               MetaConnectionStatus @default(ACTIVE)
  connectedAt          DateTime             @default(now())
  lastSyncedAt         DateTime?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedBy User              @relation("MetaPageConnectionConnector", fields: [connectedByUserId], references: [id])
  managedPages MetaManagedPage[]

  @@index([metaUserId])
  @@index([status])
}

// Pages reachable via the page-management connection. Mirrors MetaPage
// but parented by MetaPageConnection so the token chains stay separate.
model MetaManagedPage {
  id                       String   @id @default(cuid())
  metaPageConnectionId     String
  metaPageId               String
  name                     String
  category                 String?
  pictureUrl               String?
  pageAccessTokenEncrypted String
  lastFetchedAt            DateTime @default(now())

  connection MetaPageConnection @relation(fields: [metaPageConnectionId], references: [id], onDelete: Cascade)
  posts      PagePost[]

  @@unique([metaPageConnectionId, metaPageId])
  @@index([metaPageConnectionId])
}

// Organic page posts composed in AdsLab. Status tracks lifecycle from
// initial DB write (PENDING) → scheduled on Meta (SCHEDULED) → published
// (PUBLISHED) or cancelled/failed.
model PagePost {
  id                   String         @id @default(cuid())
  tenantId             String
  // FK to MetaManagedPage.id — the page this post belongs to.
  managedPageId        String
  // Convenience: Meta page id, denormalized for fast lookup.
  metaPageId           String
  // Caption text (Thai/English mixed allowed).
  caption              String         @db.Text
  // Array of public Vercel-Blob URLs. Photos OR a single video URL.
  mediaUrls            Json
  // Auto-detected from media count + content-type.
  postKind             PagePostKind   @default(PHOTO)
  // The scheduled publish time the user picked.
  scheduledAt          DateTime
  // Meta post id once it accepts the schedule; null until then.
  metaPostId           String?
  status               PagePostStatus @default(PENDING)
  errorMessage         String?        @db.Text
  // AI-tool-call origin (when present): conversation id from chat-service.
  conversationId       String?
  createdByUserId      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  // Set once publish completes (we observe via reconciliation).
  publishedAt          DateTime?

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  managedPage MetaManagedPage @relation(fields: [managedPageId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledAt])
  @@index([managedPageId, status])
}

enum PagePostKind {
  PHOTO
  ALBUM
  VIDEO
}

enum PagePostStatus {
  PENDING     // row created, Meta call in flight
  SCHEDULED   // Meta accepted with scheduled_publish_time
  PUBLISHED   // Meta confirmed publish
  CANCELLED   // user cancelled or Meta DELETE succeeded
  FAILED      // Meta rejected the schedule call
}

// The goal/intent attached to a campaign. Three sources of truth,
// resolved at report time in priority order:
//   USER_MANUAL > AUTO_NAME (via NamingConvention) > AUTO_META > TENANT_DEFAULT
model CampaignGoal {
  id            String        @id @default(cuid())
  tenantId      String
  // FK to MetaCampaign.id. Null when this is a tenant-level default
  // (no specific campaign). Unique so each campaign has at most one goal row.
  campaignId    String?       @unique
  objective     GoalObjective
  primaryKpi    GoalKpi?
  // Target threshold for primaryKpi, e.g. 2.5 for ROAS, 50 for CPM.
  primaryTarget Float?
  // Optional list of additional KPIs to track. Shape:
  //   [{ "kpi": "CTR", "target": 1.5 }, ...]
  secondaryKpis Json?
  source        GoalSource
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign MetaCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([source])
}

// Audit trail for every Meta API write performed via AdsLab. Lets us
// answer "who paused this and when?" + reverse a mistake. Append-only.
model CampaignActionLog {
  id             String               @id @default(cuid())
  tenantId       String
  // FK to MetaCampaign.id — kept even if the campaign row is later
  // deleted, so we can still produce a who/what/when audit.
  campaignId     String
  // Denormalized for fast lookup + audit even after MetaCampaign change.
  metaCampaignId String
  userId         String
  action         CampaignActionType
  // Status snapshot — populated only for PAUSE/RESUME. Kept on the
  // model for backward compat with v1 logs (would be lost in a JSON
  // migration). e.g. before="ACTIVE", after="PAUSED".
  beforeStatus   String?
  afterStatus    String?
  // Generic value snapshot for non-status actions. Shape examples:
  //   SET_BUDGET:    { dailyBudget: 50000, lifetimeBudget: null } (minor units)
  //   SET_END_DATE:  { endTime: "2026-06-15T10:00:00Z" }
  beforeValue    Json?
  afterValue     Json?
  result         CampaignActionResult
  errorMessage   String?              @db.Text
  createdAt      DateTime             @default(now())

  @@index([tenantId, createdAt])
  @@index([campaignId])
}

// User-defined rules that infer an objective from the campaign name.
// Evaluated in priority order (desc); first match wins.
model NamingConvention {
  id        String        @id @default(cuid())
  tenantId  String
  // Either a substring (case-insensitive) or a regex source string.
  pattern   String
  isRegex   Boolean       @default(false)
  objective GoalObjective
  // Higher = checked first. Lets users override broad rules with
  // narrower ones without renaming.
  priority  Int           @default(0)
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pattern])
  @@index([tenantId, priority])
}

// ============================================================
// Phase 7 — AI Master (chat + tool use + RAG)
// ============================================================

// One row per AI chat thread. Per-user-per-tenant — different users in
// a tenant get independent conversations so they don't collide on
// pending tool confirmations.
model AIConversation {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  // Human-readable title; we let the AI propose it from the first turn.
  title     String   @default("")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@index([tenantId, userId, archived])
}

// Each turn in a conversation. `role` aligns with the OpenAI/Claude
// message role; `tool_call` and `tool_result` are used when the AI
// invokes a registered tool and we feed back the result.
model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  // "user" | "assistant" | "tool_call" | "tool_result"
  role           String
  /**
   * Plain text content for user/assistant turns. For tool_call this is
   * a short summary like "calling listCampaigns(...)". For tool_result
   * this is the JSON-stringified tool output.
   */
  content        String   @db.Text
  /**
   * When role=assistant and the AI invoked tools, this captures the
   * full tool_use blocks for replay. Shape: Array<{ id, name, input }>
   */
  toolCalls      Json?
  // Promptly accept/reject state for mutate-tool calls awaiting user
  // confirmation. null = N/A, "pending" | "approved" | "rejected".
  pendingAction  String?
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Tenant-level AI persona override. One row per tenant; defaults
// applied at runtime if no row exists.
model AIPersona {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  // Short label e.g. "Thai media buyer expert"
  role               String   @default("Thai media buyer expert")
  // Free-form additional instructions appended to the system prompt
  customInstructions String   @default("") @db.Text
  ragEnabled         Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Source document the user uploaded to teach the AI domain context.
// We keep the raw original (text / pdf bytes / URL) for re-chunking
// if the chunking strategy improves later.
model KnowledgeDocument {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  // "text" | "pdf" | "url"
  sourceType      String
  // For "pdf": original filename, byteSize. For "url": fetched-at, final URL.
  sourceMeta      Json?
  // "processing" | "ready" | "failed"
  status          String   @default("processing")
  errorMessage    String?
  chunkCount      Int      @default(0)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId, status])
}

// Embedded chunk of a document. Vector type requires pgvector
// extension — we enable it via a manual `prisma db execute` step
// before `db push`. See migrations note in tasks.md.
model KnowledgeChunk {
  id         String                      @id @default(cuid())
  documentId String
  content    String                      @db.Text
  // 1536-dim embedding from OpenAI text-embedding-3-small.
  // Prisma doesn't have a native vector type yet — we use
  // Unsupported and query via raw SQL for cosine similarity.
  embedding  Unsupported("vector(1536)")
  tokens     Int                         @default(0)
  // Position in the source document for stable referencing in UI.
  ordinal    Int                         @default(0)
  createdAt  DateTime                    @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ============================================================
// Phase 6b — Tenant-level scope (account + campaign default)
// ============================================================

// Per-tenant default filter. Defines the "universe" of accounts +
// campaigns this tenant is concerned with. A user's per-user pref
// (UserAccountPreference) narrows further within this universe.
//
// Both fields nullable = "no constraint from this side".
//   accountIds  = null → tenant uses all connected ad accounts
//   campaignIds = null → tenant uses all campaigns under selected accounts
//
// Stored as JSON to avoid migration churn when ids change. Validated
// at the API boundary.
model TenantScope {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  accountIds           Json? // string[] | null  (metaAccountIds, e.g. "act_123")
  campaignIds          Json? // string[] | null  (metaCampaignIds — explicit pins)
  /**
   * Name patterns that auto-include matching campaigns at read time.
   * Lets the user write `CPS*` once and have all current + future
   * `CPS*`-named campaigns roll into scope automatically.
   * Shape: `Array<{ pattern: string; kind: "contains" | "starts_with" | "regex"; caseInsensitive?: boolean }>`
   * Effective scope campaign list = union(explicit campaignIds,
   * campaigns matching any pattern).
   */
  campaignNamePatterns Json?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// User-defined campaign naming standard. Surfaces in Settings as a list
// of templates the tenant has agreed on; Campaign Builder reads them to
// show suggestions and validate the name field.
//
// `pattern` uses {Placeholder} syntax. Supported placeholders:
//   {MM} / {YY} / {YYYY} / {DD} — date parts
//   {Month}  — short English month (Jan, Feb, ...)
//   {Custom} — placeholder for user-filled value (any text)
//
// Example pattern: "CPS_{MM}{YY}"  →  "CPS_0626"
model NamingTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  name            String // human label e.g. "CPS Campaign"
  pattern         String // template w/ placeholders
  description     String?
  /**
   * If true, this template is shown as a one-click suggestion in
   * Campaign Builder. Multiple templates can be default (= shown
   * together as suggestions, user picks one).
   */
  isDefault       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ============================================================
// Phase 6a — Multi-platform UX scaffolding
// ============================================================

// Per-user, per-tenant filter selecting which ad accounts the user
// wants to see across Dashboard / Reports / Campaigns / Audiences /
// Events. Null `selectedAccountIds` = "all accounts" (default).
//
// Stored as JSON array (of metaAccountId strings) for now — when we
// add multi-platform we'll prefix each id with platform code.
model UserAccountPreference {
  id                 String   @id @default(cuid())
  userId             String
  tenantId           String
  selectedAccountIds Json? // string[] | null
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// Email waitlist for not-yet-supported platforms (Google, TikTok).
// Captures interest signal before we commit to building the integration.
// No auth required to submit; we rate-limit by IP on the API.
model PlatformWaitlist {
  id        String   @id @default(cuid())
  email     String
  platform  String // "google" | "tiktok" | ...
  tenantId  String?
  userId    String?
  source    String? // "settings" | "coming_soon_page" | ...
  createdAt DateTime @default(now())

  @@index([email, platform])
  @@index([platform, createdAt])
}

// ============================================================
// Phase 5 — Event Tracking SDK (PixelYourSite-style)
// ============================================================

// Tenant-defined rule that the SDK uses to auto-fire Meta Pixel events.
// One Pixel can have many rules; each rule maps a trigger (URL match,
// click, form submit, scroll, time on page) to a Meta event name.
//
// `conditions` and `paramsExtractor` are JSON blobs whose shape depends
// on `triggerType` — too variable for a normalized schema. Validated at
// the API boundary instead.
model EventRule {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  // Meta Pixel ID (e.g. "123456789012345"). Not a FK — Pixel lives in Meta.
  pixelId         String
  // "url" | "click" | "form_submit" | "scroll" | "time_on_page" | "custom_js"
  triggerType     String
  conditions      Json
  // Meta standard event name: "Purchase", "Lead", "AddToCart", etc.
  // Or custom string for non-standard events.
  eventName       String
  // Optional: how to extract dynamic params (value, currency, content_ids)
  // from the page. Shape: { value: {type, selector, attr?}, ... }
  paramsExtractor Json?
  enabled         Boolean   @default(true)
  // Stats (denormalized counters to avoid scanning EventLog on every page).
  totalFires      Int       @default(0)
  lastFiredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdByUserId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
  @@index([tenantId, pixelId])
}

// Per-event audit log. Captured both for the user's debug view and
// for our own metering. We keep payload JSON small (only fields we
// actually need — Meta-required + identifying context).
model EventLog {
  id             String   @id @default(cuid())
  tenantId       String
  ruleId         String?
  firedAt        DateTime @default(now())
  eventName      String
  // The full CAPI payload (custom_data + user_data hashed). Useful for
  // debugging dedup issues and re-sending.
  payload        Json
  // Stable id shared between Pixel (browser) + CAPI (server) calls so
  // Meta dedupes within ~48h. Generated by the SDK per fire.
  dedupKey       String
  // "pending" | "success" | "failed" | "skipped"
  capiStatus     String
  capiResponse   Json?
  // Browser context: { userAgent, fbp, fbc, sourceUrl, referrer }
  browserContext Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, firedAt(sort: Desc)])
  @@index([dedupKey])
}

// Long-lived access token for Meta Conversions API calls. Separate from
// the user OAuth token in MetaConnection because CAPI prefers System
// User tokens (don't expire, scoped to the BM). Falls back to user token
// for MVP if System User generation is deferred.
model CapiAccessToken {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  // AES-encrypted token (re-uses src/lib/auth/encryption.ts).
  encryptedToken String
  // "USER" | "SYSTEM_USER"
  tokenType      String
  // ISO date or null = never expires (system user tokens).
  expiresAt      DateTime?
  // For verification / display.
  metaUserId     String?
  metaUserName   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ============================================================
// Billing & Subscriptions (Phase 9)
// ============================================================

// Plan catalog. Seeded by `prisma/seed/plans.ts`. `key` is the stable
// identifier referenced by code (e.g. "starter", "growth", "pro",
// "scale", and add-on keys "event-sdk" / "white-label" / etc.).
// Add-on rows have `isAddOn = true` and may have null spendCeiling.
model Plan {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  // THB integers (no decimals — prices end in 90/990).
  priceMonthly    Int
  priceYearly     Int
  // Ad spend ceiling in THB. null = enterprise / unbounded.
  spendCeilingThb Int?
  adAccountLimit  Int      @default(1)
  // Daily AI message cap. null = unlimited.
  aiMsgPerDay     Int?
  isAddOn         Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions TenantSubscription[]
}

// One subscription per tenant. addOnKeys is a flat array — we don't
// model it as a join table because add-ons rarely change and we want
// snapshot-style reads. extraAdAccounts is an extra count purchased
// via the "extra-ad-account" add-on (each ฿190/mo, multiplier).
model TenantSubscription {
  id                     String             @id @default(cuid())
  tenantId               String             @unique
  planId                 String
  status                 SubscriptionStatus
  interval               BillingInterval    @default(MONTHLY)
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  // Omise identifiers — present once user submits payment info.
  omiseCustomerId        String?
  omiseCardId            String?
  // Active add-on keys (subset of Plan.key where isAddOn=true).
  addOnKeys              String[]           @default([])
  // Extra ad accounts beyond plan.adAccountLimit (each billed at
  // ฿190/mo via the extra-ad-account add-on).
  extraAdAccounts        Int                @default(0)
  // Computed by billing-tick cron after sustained spend overage.
  tierUpgradeRecommended Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
}

// Every charge attempt — successful or failed. Idempotency via
// omiseChargeId UNIQUE so webhook replays are safe.
model Invoice {
  id                 String        @id @default(cuid())
  tenantId           String
  omiseChargeId      String?       @unique
  amount             Int
  currency           String        @default("THB")
  status             InvoiceStatus @default(PENDING)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  paidAt             DateTime?
  failureCode        String?
  failureMessage     String?
  receiptUrl         String?
  // Line-item snapshot at charge time: { planKey, planPrice,
  // addOns: [{ key, price }], extraAdAccounts, vat: 7%, total }
  lineItems          Json
  createdAt          DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status])
}

// Per-tenant per-day rollup. AI message count and token counts come
// from chat-service writes; adSpendThb comes from billing-tick cron
// (sum of Meta account_insights for that day).
model UsageMetric {
  id              String   @id @default(cuid())
  tenantId        String
  date            DateTime @db.Date
  aiMessagesCount Int      @default(0)
  aiInputTokens   BigInt   @default(0)
  aiOutputTokens  BigInt   @default(0)
  adSpendThb      Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([date])
}

// Immutable audit log of billing state transitions. idempotencyKey
// is the Omise event ID so webhook replays don't double-insert.
model BillingEvent {
  id             String           @id @default(cuid())
  tenantId       String
  kind           BillingEventKind
  // null for events not tied to an Omise webhook (e.g. local trial
  // reminder sent). UNIQUE so webhook is idempotent.
  idempotencyKey String?          @unique
  payload        Json
  createdAt      DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([kind])
}

// Public read-only share links for ad performance views. Operator
// generates a token-protected URL (/v/<token>) and sends it to a client
// who has no AdsLab login. Soft delete via isActive so audit fields
// (viewCount, lastViewedAt) survive a revoke. scope is "ACCOUNT" or
// "CAMPAIGN"; targetId is the Meta account ID or Meta campaign ID
// depending on scope.
model ViewerLink {
  id           String    @id @default(cuid())
  token        String    @unique
  tenantId     String
  scope        String
  targetId     String
  dateRange    String    @default("7d")
  isActive     Boolean   @default(true)
  createdById  String
  createdAt    DateTime  @default(now())
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ViewerLinkCreator", fields: [createdById], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([token])
}

// DB cache for Meta ad creative preview URLs (image / video thumbnail).
// One row per Meta creative ID (creatives are reused across many ads,
// so this is smaller than caching per-ad). The public viewer route
// reads from here first; on miss/expiry, fetches from Meta and
// upserts. TTL ~7 days (Meta CDN URLs are stable but signed).
model MetaAdCreativePreview {
  id            String   @id @default(cuid())
  creativeId    String   @unique
  type          String
  imageUrl      String?
  videoThumbUrl String?
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

// ============================================================
// Hook Lab v2 — hook generation / iteration / analysis
// ============================================================

/// One drafted or analyzed hook concept. Rows come from 4 sources:
///   - "generated"    → Generate mode big-swing concept (angle/avatar/etc.)
///   - "iteration"    → Iterate mode single-lever variation of a parent winner
///   - "analyzed"     → Analyze mode paste-and-score (may or may not be saved)
///   - "manual"       → user typed their own concept
/// `generationId` groups rows produced by one call (Generate returns 3
/// concepts; Iterate returns 3–5 iterations — all share one generationId).
/// `parentConceptId` self-references the row this iteration was built off
/// (null for generated/analyzed/manual).
model HookConcept {
  id                       String   @id @default(cuid())
  tenantId                 String
  createdByUserId          String
  /// Groups rows produced by one call. Same for all N concepts/iterations
  /// returned by a single Generate or Iterate invocation.
  generationId             String
  /// "generated" | "iteration" | "analyzed" | "manual"
  source                   String
  /// FK to another HookConcept.id — the winner/control this iteration was
  /// built from. Null for generated/analyzed/manual rows. onDelete:SetNull
  /// so deleting the parent winner doesn't nuke its iteration history.
  parentConceptId          String?
  textHookTh               String?
  textHookEn               String?
  /// Markdown body outline.
  bodyOutline              String?  @db.Text
  /// Array of visual directions. Shape:
  /// `Array<{ name, description, shotList[], hypothesis, whyDifferent, format?, aspectRatio?, durationSec? }>`
  /// Generate mode: 3 directions per concept. Iterate mode: 1 direction.
  visualDirections         Json?
  /// For iterations: which single lever was changed.
  /// One of: "opening_beat" | "first_frame" | "actor_age" |
  /// "actor_ethnicity" | "format_style" | "callout_wording".
  leverChanged             String?
  /// Free-form hypothesis. Required by prompt for iterations
  /// ("no iteration without hypothesis" — Nick's rule).
  hypothesis               String?  @db.Text
  /// For generated concepts: what changed from control.
  /// Shape: `{ angle?, avatar?, awareness?, sophistication?, desire? }`
  angleChange              Json?
  /// "unaware" | "problem" | "solution" | "product" | "most"
  awarenessStage           String?
  /// 1-5
  sophisticationStage      Int?
  avatar                   String?
  /// Control (winner) hook text this concept was drafted against (if any).
  controlHookText          String?  @db.Text
  controlBodyText          String?  @db.Text
  /// Body-hook alignment score 0..1 from BODY_HOOK_ALIGNMENT_PROMPT.
  alignmentScore           Float?
  /// "aligned" | "partial" | "misaligned"
  alignmentVerdict         String?
  /// "clearly-different" | "partial-swing" | "same-visual-bucket"
  visualDiffVerdict        String?
  /// Combined heuristic risk label. "LOW" | "MEDIUM" | "HIGH".
  andromedaRisk            String?
  /// True if user hit "Save anyway" on the HIGH-risk warn+confirm modal.
  /// Telemetry for downstream hit-rate analysis.
  andromedaOverrideChosen  Boolean  @default(false)
  /// Nick RAG citations used. Shape:
  /// `Array<{ ordinal, title, url, similarity }>`
  citations                Json?
  /// "draft" | "testing" | "winner" | "archived" (soft-delete via status)
  status                   String   @default("draft")
  notes                    String?  @db.Text
  /// Populated when user launches this concept as a Meta campaign.
  metaCampaignId           String?
  metaAdSetId              String?
  promptTokens             Int?
  completionTokens         Int?
  costUsd                  Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      HookConcept?  @relation("HookConceptIterations", fields: [parentConceptId], references: [id], onDelete: SetNull)
  iterations  HookConcept[] @relation("HookConceptIterations")

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, generationId])
  @@index([parentConceptId])
}

/// One Analyze-mode submission. Kept separately from HookConcept because
/// Analyze is a scoring flow, not necessarily a saved concept. Users can
/// promote an analyzed row into a HookConcept row via the "save" action.
model HookAnalysis {
  id                 String   @id @default(cuid())
  tenantId           String
  createdByUserId    String
  /// The user's pasted text hook to score.
  inputTextHook      String   @db.Text
  /// Optional pasted control hook + body to run body-hook alignment against.
  controlHookText    String?  @db.Text
  controlBodyText    String?  @db.Text
  imageUrl           String?
  product            String?
  audience           String?
  /// 1-5 Golden-Formula scores.
  scoreStopScroll    Int
  scoreCuriosity     Int
  scoreBenefit       Int
  scoreAlignment     Int
  /// "green" | "yellow" | "red" or similar verdict emitted by prompt.
  verdict            String
  /// Per-axis 1-line reasons. Shape:
  /// `{ stopScroll: string, curiosity: string, benefit: string, alignment: string }`
  reasoning          Json
  /// 3 rewrite suggestions. Shape:
  /// `Array<{ text, angle, whyBetter }>`
  rewrites           Json
  /// "LOW" | "MEDIUM" | "HIGH"
  andromedaRisk      String
  andromedaReasoning String?  @db.Text
  /// Nick RAG citations used. Shape:
  /// `Array<{ ordinal, title, url, similarity }>`
  citations          Json
  promptTokens       Int?
  completionTokens   Int?
  costUsd            Float?
  createdAt          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
}

/// Per-tenant profile capturing product/audience/desire so Generate and
/// Iterate forms auto-prefill on repeat visits. One row per tenant.
model HookProfile {
  id                     String   @id @default(cuid())
  tenantId               String   @unique
  product                String   @db.Text
  audience               String   @db.Text
  desire                 String   @db.Text
  /// "unaware" | "problem" | "solution" | "product" | "most"
  awarenessDefault       String?
  /// 1-5
  sophisticationDefault  Int?
  /// "th" | "en" | "both"
  language               String   @default("both")
  updatedByUserId        String
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Cache row for Meta-detected top winners per tenant. Populated by the
/// detect-winners flow (campaigns_list → ads_list_ads_in_account →
/// insights_get_ad → creative + preview → META_WINNER_INTERPRETER_PROMPT).
/// TTL via `cachedUntil`. One row per (tenantId, metaAdId).
model HookWinner {
  id                  String   @id @default(cuid())
  tenantId            String
  metaAdId            String
  metaCampaignId      String?
  metaAdSetId         String?
  textHook            String   @db.Text
  body                String?  @db.Text
  /// "video" | "image" | "carousel"
  creativeType        String?
  /// Normalized visual description from META_WINNER_INTERPRETER_PROMPT.
  visualSummary       String?  @db.Text
  /// Dominant attribute chips. Shape:
  /// `Array<string>` e.g. ["ethnicity:asian-female-30s","format:UGC","duration:~15s"]
  dominantAttributes  Json?
  spend               Float?
  purchaseRoas        Float?
  ctr                 Float?
  linkClicks          Int?
  impressions         Int?
  detectedAt          DateTime
  cachedUntil         DateTime
  /// Detection warnings surfaced to UI. Shape:
  /// `Array<{ code, message }>` — e.g. rate_limited, insufficient_data.
  warnings            Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metaAdId])
  @@index([tenantId, cachedUntil])
}
